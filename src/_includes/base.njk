<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title or settings.site_name }}</title>
<meta name="description" content="{{ description or (settings.tagline | striptags) }}">
<link rel="canonical" href="{{ settings.site_url }}{{ page.url }}">
<meta property="og:type" content="{{ og_type or 'website' }}">
<meta property="og:site_name" content="{{ settings.site_name }}">
<meta property="og:title" content="{{ title or settings.site_name }}">
<meta property="og:description" content="{{ description or (settings.tagline | striptags) }}">
<meta property="og:url" content="{{ settings.site_url }}{{ page.url }}">
<meta property="og:image" content="{{ settings.site_url }}{{ og_image or '/assets/og-default.png' }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"{{ settings.site_name }}","legalName":"The Yard Lab Publishing Group, LLC","url":"{{ settings.site_url }}","logo":"{{ settings.site_url }}/assets/yardlab-logo-full.png","foundingDate":"{{ settings.founded_year }}","email":"{{ settings.contact_email }}","address":{"@type":"PostalAddress","addressLocality":"Novato","addressRegion":"CA","addressCountry":"US"}}</script>
{% if schema %}<script type="application/ld+json">{{ schema | dump | safe }}</script>{% endif %}
<link rel="icon" type="image/png" href="/assets/favicon.png">
<link rel="stylesheet" href="/styles.css">
{% block head %}{% endblock %}
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
{% set publishedArticles = articles | selectattr("link") %}

<!-- ANNOUNCEMENT -->
<div class="announce">
  <span class="pin">●</span>
  {{ settings.announcement_text | safe }} &nbsp; <a href="{{ settings.announcement_link_url }}">{{ settings.announcement_link_text }} →</a>
</div>

<!-- HEADER -->
<header class="header">
  <div class="header-inner">
    <a href="/" class="logo">
      <img src="/assets/yardlab-icon.png" alt="The Yard Lab" class="logo-mark">
      <span class="logo-text">
        <span class="logo-name">The Yard Lab<span class="ampersand">.</span></span>
        <span class="logo-sub">Publishing Group · Est. {{ settings.founded_year }}</span>
      </span>
    </a>
    <nav class="primary" id="primary-nav" aria-label="Primary">
      <a href="/#catalog"{% if active_nav == 'catalog' %} class="active"{% endif %}>Catalog</a>
      <a href="/#lab"{% if active_nav == 'lab' %} class="active"{% endif %}>The Lab.</a>
      {% if publishedArticles | length %}<a href="/#reading-room"{% if active_nav == 'reading' %} class="active"{% endif %}>Reading Room</a>{% endif %}
      <a href="/authors/m-patrick-furry/"{% if active_nav == 'authors' %} class="active"{% endif %}>Authors</a>
      <a href="/#submissions"{% if active_nav == 'submissions' %} class="active"{% endif %}>Submissions</a>
      <a href="/#about"{% if active_nav == 'about' %} class="active"{% endif %}>About</a>
    </nav>
    <div class="header-actions">
      <a href="/#newsletter" class="subscribe-link">Subscribe</a>
      <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="primary-nav"><span class="bars" aria-hidden="true"></span>Menu</button>
    </div>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<!-- FOOTER -->
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <img src="/assets/yardlab-logo-full-light.png" alt="The Yard Lab Publishing Group" class="footer-logo-image">
        <p>{{ settings.tagline | safe }}</p>
      </div>

      <div class="footer-col">
        <h5>Catalog</h5>
        <ul>
          {% for book in catalog %}{% if book.in_catalog and book.page_link.indexOf('/books/') == 0 %}
          <li><a href="{{ book.page_link }}">{{ book.title }}</a></li>
          {% endif %}{% endfor %}
          <li><a href="/#lab">Forthcoming: The Lab. Annual</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h5>The Lab.</h5>
        <ul>
          <li><a href="/#lab">About the Annual</a></li>
          <li><a href="/#submissions">Submit</a></li>
          <li><a href="/#newsletter">Subscribe</a></li>
          {% if publishedArticles | length %}<li><a href="/#reading-room">Reading Room</a></li>{% endif %}
        </ul>
      </div>

      <div class="footer-col">
        <h5>The Press</h5>
        <ul>
          <li><a href="/#about">About</a></li>
          <li><a href="/#submissions">Submissions</a></li>
          <li><a href="/authors/m-patrick-furry/">Authors</a></li>
          {% if publishedArticles | length %}<li><a href="/#reading-room">Reading Room</a></li>{% endif %}
        </ul>
      </div>

      <div class="footer-col">
        <h5>Connect</h5>
        <ul>
          <li><a href="/#newsletter">Newsletter</a></li>
          {% if settings.instagram_url %}<li><a href="{{ settings.instagram_url }}">Instagram</a></li>{% endif %}
          {% if settings.bluesky_url %}<li><a href="{{ settings.bluesky_url }}">Bluesky</a></li>{% endif %}
          <li><a href="mailto:{{ settings.contact_email }}">Contact</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="colophon">Set in Cormorant Garamond &amp; EB Garamond. Printed in California.</div>
      <div class="footer-bottom-links">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <span>© 2026 The Yard Lab Publishing Group, LLC</span>
      </div>
    </div>
  </div>
</footer>

<script>
  (function () {
    var btn = document.querySelector('.menu-toggle'), nav = document.getElementById('primary-nav');
    if (!btn || !nav) return;
    btn.addEventListener('click', function () {
      var open = nav.classList.toggle('open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    nav.addEventListener('click', function (e) {
      if (e.target.tagName === 'A') { nav.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && nav.classList.contains('open')) { nav.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); btn.focus(); }
    });
  })();
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.08 });
  document.querySelectorAll('.fade-in').forEach(el => io.observe(el));
  setTimeout(() => {
    document.querySelectorAll('.fade-in:not(.visible)').forEach(el => el.classList.add('visible'));
  }, 4000);
</script>


<!-- Cookie consent banner -->
<div id="cookie-banner" class="cookie-banner" hidden>
  <div class="cookie-banner-inner">
    <p class="cookie-text">
      This site uses essential cookies for form submissions and basic functionality. We do not use tracking, analytics, or advertising cookies. <a href="/privacy/">Privacy policy</a>.
    </p>
    <div class="cookie-actions">
      <button type="button" class="cookie-btn cookie-decline" id="cookie-decline">Decline</button>
      <button type="button" class="cookie-btn cookie-accept" id="cookie-accept">Accept</button>
    </div>
  </div>
</div>

<style>
.cookie-banner {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: var(--ink); color: var(--paper);
  border-top: 1px solid var(--gold);
  padding: 20px 40px; z-index: 1000;
  font-family: var(--font-ui);
  box-shadow: 0 -8px 24px rgba(0,0,0,0.18);
  transform: translateY(100%);
  transition: transform 0.45s ease;
}
.cookie-banner.visible { transform: translateY(0); }
.cookie-banner-inner {
  max-width: 1400px; margin: 0 auto;
  display: flex; align-items: center; justify-content: space-between;
  gap: 32px; flex-wrap: wrap;
}
.cookie-text {
  font-size: 13px; line-height: 1.55;
  color: rgba(251, 250, 247,0.85); margin: 0;
  max-width: 760px;
}
.cookie-text a {
  color: var(--gold);
  border-bottom: 1px solid rgba(240, 138, 75,0.4);
  text-decoration: none;
}
.cookie-text a:hover { border-bottom-color: var(--gold); }
.cookie-actions { display: flex; gap: 12px; }
.cookie-btn {
  font-family: var(--font-ui); font-size: 11px; font-weight: 600;
  letter-spacing: 0.2em; text-transform: uppercase;
  padding: 10px 20px; cursor: pointer;
  border: 1px solid var(--paper); background: transparent; color: var(--paper);
  transition: all 0.2s;
}
.cookie-accept { background: var(--paper); color: var(--ink); }
.cookie-accept:hover { background: var(--gold); border-color: var(--gold); color: var(--ink); }
.cookie-decline:hover { border-color: var(--gold); color: var(--gold); }
@media (max-width: 640px) {
  .cookie-banner { padding: 16px 20px; }
  .cookie-banner-inner { gap: 16px; }
  .cookie-actions { width: 100%; }
  .cookie-btn { flex: 1; }
}
</style>

<script>
(function() {
  var KEY = 'yardlab-cookie-consent';
  var banner = document.getElementById('cookie-banner');
  if (!banner) return;
  var stored = null;
  try { stored = localStorage.getItem(KEY); } catch(e) {}
  if (stored === 'accepted' || stored === 'declined') return;
  banner.hidden = false;
  requestAnimationFrame(function() { banner.classList.add('visible'); });
  function dismiss(choice) {
    try { localStorage.setItem(KEY, choice); } catch(e) {}
    banner.classList.remove('visible');
    setTimeout(function() { banner.hidden = true; }, 450);
  }
  document.getElementById('cookie-accept').addEventListener('click', function() { dismiss('accepted'); });
  document.getElementById('cookie-decline').addEventListener('click', function() { dismiss('declined'); });
})();
</script>

</body>
</html>
