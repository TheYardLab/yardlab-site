@media (max-width: 640px) { .notice-wrap { padding: 0 20px 60px; } .notice { padding: 28px 24px; } }
</style>

<!-- HERO -->
<section class="hero">
  <div class="hero-grid">
    <div class="hero-text">
      <div class="hero-eyebrow">{{ homepage.hero_eyebrow }}</div>
      <h1>{{ homepage.hero_headline | safe }}</h1>
      <p class="lede">{{ homepage.hero_description | safe }}</p>
      <div class="hero-actions">
        <a href="#catalog" class="btn btn-primary">Browse Our Books <span class="arrow">→</span></a>
        <a href="#submissions" class="btn btn-ghost">Submission Info</a>
      </div>
    </div>

  </div>
</section>

<!-- CATALOG -->
<section class="section new-notable fade-in" id="catalog">
  <div class="section-label">Available Now</div>
  <h2 class="section-title">{{ homepage.catalog_heading | safe }}</h2>
  <p class="section-sub">{{ homepage.catalog_sub | safe }}</p>

  <div class="titles-grid">
    {% for book in catalog %}{% if book.in_catalog %}
    <div class="title-entry">
    <a href="{{ book.page_link }}" class="title-card">
      <div class="title-cover">
        {% if book.cover_style == 'image' and book.cover_image %}
          <img src="{{ book.cover_image }}" alt="{{ book.title }}">
        {% elif book.cover_style == 'keene' %}
          <div class="cover-keene">
            <div class="label-top">A Novel</div>
            <div class="title">
              <span class="t-small">The Casual</span>
              <span class="t-big">Oblivion</span>
              <span class="t-small">of Francis Keene</span>
            </div>
            <div class="ornament">❦</div>
            <div class="author">M. Patrick Furry</div>
          </div>
        {% elif book.cover_style == 'lab' %}
          <div class="cover-lab">
            <div class="lab-top">
              <span>N°1</span>
              <span>Annual · 2027</span>
            </div>
            <div class="lab-title">The Lab<span class="dot">.</span></div>
            <div class="lab-tagline">An annual of new short fiction.</div>
            <div class="lab-contents">
              <strong>In Development</strong>
              Forthcoming 2027, with selected work from open submissions and a featured excerpt.
            </div>
          </div>
        {% endif %}
      </div>
      <div class="title-format">{{ book.format }}</div>
      <h3 class="title-name">{{ book.title_html | safe }}</h3>
      <p class="title-author">{{ book.author }}</p>
      <p class="title-desc">{{ book.description }}</p>
      <div class="shelf-talk">
        <strong>Shelf Talk</strong>
        "{{ book.shelf_talk }}" — {{ book.shelf_talk_by }}
      </div>
      <span class="title-link">{% if book.page_link.indexOf('/books/') == 0 %}About the book{% else %}Read more{% endif %}</span>
    </a>
    {% if book.page_link.indexOf('/books/') == 0 %}
    <div class="title-actions">
      <a href="{{ book.page_link }}#buy" class="buy">Buy the book</a>
      {% if book.audible_url %}<a href="{{ book.audible_url }}" target="_blank" rel="noopener">Listen on Audible</a>{% endif %}
    </div>
    {% endif %}
    </div>
    {% endif %}{% endfor %}
  </div>
</section>

<!-- SUBMISSIONS NOTICE -->
<section class="notice-wrap">
  <div class="hero-feature notice">
    <div class="notice-text">

      <div class="hero-feature-label">Currently Closed</div>
      <h3>{{ homepage.now_reading_title | safe }}</h3>
      <p class="issue">{{ homepage.now_reading_issue }}</p>
      <p>{{ homepage.now_reading_desc | safe }}</p>
      <div class="deadline">
        <span>Reopens</span>
        <strong>{{ homepage.now_reading_deadline }}</strong>
      </div>
    </div>
    <div class="notice-action">
      <form class="js-notify" action="https://formspree.io/f/mdajpeel" method="POST">
        <label class="notify-label" for="notify-email">Get a note the day we reopen</label>
        <div class="notify-form">
          <input type="email" id="notify-email" name="email" placeholder="your@email.com" autocomplete="email" required>
          <input type="hidden" name="_subject" value="Newsletter Subscription (reopening notice) — The Yard Lab">
          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true">
          <button type="submit">Notify me</button>
        </div>
        <p class="notify-msg" role="status" aria-live="polite"></p>
      </form>
      <a href="#submissions" class="small-link">Submission Guidelines</a>
    </div>
  
  </div>
</section>

<!-- READING ROOM (shown once at least one article has a link) -->
{% set publishedArticles = articles | selectattr("link") %}
{% if publishedArticles | length %}
<section class="reading-room fade-in" id="reading-room">
  <div class="reading-room-inner">
    <div class="reading-room-header">
      <div>
        <div class="section-label">The Reading Room</div>
        <h2 class="section-title">Essays, notes, and <em>dispatches</em> from the press.</h2>
      </div>
      <a href="/#reading-room" class="view-all">All Articles</a>
    </div>

    <div class="articles-grid">
      {% for article in articles %}
      {% if article.link %}<a href="{{ article.link }}"{% else %}<div{% endif %} class="article-card{% if article.featured %} featured{% endif %}{% if not article.link %} soon{% endif %}">
        <div class="article-image article-image-{% if article.image_style == 'play' %}1{% elif article.image_style == 'infinity' %}2{% else %}4{% endif %}">{% if article.image %}<img src="{{ article.image }}" alt="{{ article.image_alt }}" loading="lazy" class="{% if article.image_style == 'infinity' %}article-logo{% else %}article-cover{% endif %}">{% endif %}</div>
        <div class="article-category">{{ article.category }} · {{ article.reading_time }}</div>
        <h3>{{ article.title | safe }}</h3>
        <div class="article-byline">{{ article.byline }} &middot; {{ article.published | monthYearLong }}</div>
        <p class="article-snippet">{{ article.snippet | safe }}</p>
        <span class="article-read">{% if not article.link %}Coming soon{% elif article.featured %}Read the essay{% else %}Continue reading{% endif %}</span>
      {% if article.link %}</a>{% else %}</div>{% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- HOME MID — featured excerpt + currently -->
<section class="home-mid fade-in">
  <div class="home-mid-grid">
    <div class="excerpt-block">
      <div class="excerpt-meta">
        <span class="category">{{ homepage.excerpt_category }}</span>
        <span class="reading-time">{{ homepage.excerpt_reading_time }}</span>
      </div>
      <h3>{{ homepage.excerpt_title | safe }}</h3>
      <div class="excerpt-byline">{{ homepage.excerpt_byline | safe }}</div>
      <blockquote>
        {% for para in homepage.excerpt_body.split("\n\n") %}<p>{{ para | safe }}</p>{% endfor %}
      </blockquote>
      <a href="{{ homepage.excerpt_link }}" class="excerpt-continues">{{ homepage.excerpt_link_text }}</a>
    </div>

  </div>
</section>

<!-- THE LAB. ANNUAL FEATURE -->
<section class="lab-feature fade-in" id="lab">
  <div class="lab-feature-inner">
    <div class="lab-feature-text">
      <div class="section-label">The Lab. <span style="color: rgba(251, 250, 247,0.3); margin-left: 8px;">N°1</span></div>
      <h2>An annual of <em>new</em> short fiction.</h2>
      <p><em>The Lab.</em> is our annual collection of short fiction and novel excerpts by emerging and established writers. We read every submission we receive, and we pay our writers.</p>
      <p>Our editors choose each year's issue, and we publish it as a print edition with the full contents available online to subscribers.</p>
      <div class="feature-meta">
        <div>Inaugural Issue<strong>N°1 · Annual 2027</strong></div>
        <div>Submissions<strong>Reopen Jan 15, 2027</strong></div>
        <div>Publication<strong>2027</strong></div>
      </div>
      <div class="lab-actions">
        <a href="#submissions" class="btn btn-light">Submission Info <span class="arrow">→</span></a>
        <a href="/#newsletter" class="btn btn-outline-light">Subscribe</a>
      </div>
    </div>
    <div class="lab-cover-display">
      <div class="cover-lab">
        <div class="lab-top"><span>N°1</span><span>Annual · 2027</span></div>
        <div class="lab-title">The Lab<span class="dot">.</span></div>
        <div class="lab-tagline">An annual of new short fiction.</div>
        <div class="lab-contents">
          <strong>In Development</strong>
          Forthcoming 2027, with selected work from open submissions and a featured excerpt.
        </div>
      </div>
    </div>
  </div>
</section>

<!-- MISSION -->
<section class="mission fade-in" id="about">
  <div class="mission-inner">
    <div class="section-label">Our Mission</div>
    <blockquote>{{ homepage.mission_text | safe }}</blockquote>
    <div class="mission-attribution">{{ homepage.mission_attribution }}</div>
  </div>
</section>

<!-- SUBMISSIONS -->
<section class="submissions fade-in" id="submissions">
  <div class="submissions-grid">
    <div class="submissions-body">
      <div class="section-label">Submissions</div>
      <h2>We're <em>closed</em>.</h2>
      <p>{{ homepage.submissions_intro | safe }}</p>
      <p>{{ homepage.submissions_detail | safe }}</p>
      <div style="margin-top:32px;padding:28px 32px;background:var(--paper-deep);border:1px solid var(--paper-edge);max-width:460px;">
        <div style="font-family:var(--font-ui);font-size:11px;font-weight:600;letter-spacing:0.25em;text-transform:uppercase;color:var(--oxblood);margin-bottom:12px;">Reopening January 15, 2027</div>
        <p style="font-size:15px;line-height:1.55;color:var(--ink-muted);margin-bottom:0;">The submission form will return here when reading resumes. In the meantime, <a href="#newsletter" style="color:var(--ink);border-bottom:1px solid var(--ink);">subscribe to our newsletter</a> and we'll send a note the day we reopen.</p>
      </div>
      <!--
      SUBMISSION FORM — commented out while submissions are closed.
      Restore by deleting this comment wrapper (and the closed-notice div above) when reading reopens January 15, 2027.
      <form action="https://formspree.io/f/mzdwkedl" method="POST" id="submit-form" style="margin-top:24px;">
        <input type="hidden" name="_subject" value="Submission — The Yard Lab">
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off">
        <div style="display:flex;flex-direction:column;gap:12px;max-width:460px;">
          <input type="text" name="name" placeholder="Your name" required style="padding:12px 16px;border:1px solid var(--paper-edge);background:var(--paper);font-family:var(--font-ui);font-size:14px;color:var(--ink);">
          <input type="email" name="email" placeholder="your@email.com" required style="padding:12px 16px;border:1px solid var(--paper-edge);background:var(--paper);font-family:var(--font-ui);font-size:14px;color:var(--ink);">
          <input type="text" name="title" placeholder="Work title" required style="padding:12px 16px;border:1px solid var(--paper-edge);background:var(--paper);font-family:var(--font-ui);font-size:14px;color:var(--ink);">
          <input type="number" name="wordcount" placeholder="Word count" min="1" style="padding:12px 16px;border:1px solid var(--paper-edge);background:var(--paper);font-family:var(--font-ui);font-size:14px;color:var(--ink);">
          <select name="type" required style="padding:12px 16px;border:1px solid var(--paper-edge);background:var(--paper);font-family:var(--font-ui);font-size:14px;color:var(--ink);">
            <option value="">Type of submission…</option>
            <option>Short Fiction (up to 7,500 words)</option>
            <option>Novel Excerpt (up to 15,000 words)</option>
            <option>Full Manuscript (query first)</option>
          </select>
          <textarea name="bio" placeholder="Brief bio (2–3 sentences)" rows="3" style="padding:12px 16px;border:1px solid var(--paper-edge);background:var(--paper);font-family:var(--font-ui);font-size:14px;color:var(--ink);resize:vertical;"></textarea>
          <button type="submit" class="btn btn-primary" id="submit-btn">Submit <span class="arrow">→</span></button>
        </div>
        <div id="submit-msg" style="margin-top:12px;font-family:var(--font-ui);font-size:13px;line-height:1.6;"></div>
      </form>
      -->
    </div>

    <div class="submissions-stats">
      <dl>
        <div><dt>Short Fiction</dt><dd>Up to <em>7,500</em> words</dd></div>
        <div><dt>Novel Excerpts</dt><dd>Up to <em>15,000</em> words</dd></div>
        <div><dt>Novellas, Short Novels &amp; Novels</dt><dd><em>By query</em> first</dd></div>
        <div><dt>Response Time</dt><dd><em>~8</em> weeks</dd></div>
        <div><dt>Reading Fee</dt><dd><em>None</em></dd></div>
        <div><dt>Payment</dt><dd>On <em>acceptance</em></dd></div>
      </dl>
    </div>
  </div>
</section>

<!-- NEWS -->
<section class="news fade-in">
  <div class="news-inner">
    <div class="section-label">News &amp; Press</div>
    <h2 class="section-title">Announcements <em>from</em> the press.</h2>

    <div class="news-grid">
      {% for item in news %}
      {% if item.link %}<a href="{{ item.link }}" class="news-card">{% else %}<div class="news-card soon">{% endif %}
        <div class="news-date">{{ item.date | monthYear }}</div>
        <h4>{{ item.headline | safe }}</h4>
        <p>{{ item.summary | safe }}</p>
        <span class="read-more">{{ item.label }}</span>
      {% if item.link %}</a>{% else %}</div>{% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<!-- NEWSLETTER -->
<section class="newsletter fade-in" id="newsletter">
  <div class="newsletter-inner">
    <div class="section-label">From the Press</div>
    <h2>Letters from <em>the lab.</em></h2>
    <p>A monthly letter with new releases, author news and reading periods for <em>The Lab.</em> No spam.</p>
    <form class="newsletter-form" action="https://formspree.io/f/mdajpeel" method="POST" id="newsletter-form">
      <input type="email" name="email" placeholder="your@email.com" required>
      <input type="hidden" name="_subject" value="Newsletter Subscription — The Yard Lab">
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off">
      <button type="submit">Subscribe</button>
    </form>
    <div class="fine-print" id="newsletter-msg"></div>
    <div class="fine-print">Unsubscribe at any time</div>
  </div>
</section>

<script>
// Submission form
(function() {
  var form = document.getElementById('submit-form');
  if (!form) return;
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var btn = document.getElementById('submit-btn');
    var msg = document.getElementById('submit-msg');
    btn.textContent = 'Sending…';
    btn.disabled = true;
    fetch(form.action, {
      method: 'POST',
      body: new FormData(form),
      headers: { 'Accept': 'application/json' }
    }).then(function(r) {
      if (r.ok) {
        btn.textContent = '✓ Details received!';
        msg.innerHTML = 'Thanks — one last step: email your manuscript as a <strong>.docx or .pdf</strong> to <a href="mailto:team@theyardlab.com?subject=Manuscript%20Attached" style="color:var(--oxblood);border-bottom:1px solid var(--oxblood);">team@theyardlab.com</a> with your name and title in the subject line. We respond to every submission within 8 weeks.';
        msg.style.color = 'var(--ink)';
        form.reset();
      } else {
        btn.textContent = 'Submit →';
        btn.disabled = false;
        msg.textContent = 'Something went wrong. Email us directly at team@theyardlab.com.';
      }
    }).catch(function() {
      btn.textContent = 'Submit →';
      btn.disabled = false;
      msg.textContent = 'Something went wrong. Email us directly at team@theyardlab.com.';
    });
  });
})();

// Reopening notice (hero)
(function() {
  document.querySelectorAll('form.js-notify').forEach(function(form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var btn = form.querySelector('button'), msg = form.querySelector('.notify-msg');
      btn.disabled = true; btn.textContent = 'Sending…';
      fetch(form.action, { method: 'POST', body: new FormData(form), headers: { 'Accept': 'application/json' } })
        .then(function(r) {
          if (!r.ok) throw new Error();
          btn.textContent = 'Done'; msg.textContent = "You're on the list. We'll write the day submissions reopen."; form.reset();
        })
        .catch(function() {
          btn.disabled = false; btn.textContent = 'Notify me';
          msg.textContent = 'Something went wrong. Email us at team@theyardlab.com.';
        });
    });
  });
})();

// Newsletter form
(function() {
  var form = document.getElementById('newsletter-form');
  if (!form) return;
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var btn = form.querySelector('button');
    var msg = document.getElementById('newsletter-msg');
    btn.textContent = 'Sending…';
    btn.disabled = true;
    fetch(form.action, {
      method: 'POST',
      body: new FormData(form),
      headers: { 'Accept': 'application/json' }
    }).then(function(r) {
      if (r.ok) {
        btn.textContent = '✓ Subscribed!';
        msg.textContent = 'Thanks — check your inbox for a confirmation.';
        form.reset();
      } else {
        btn.textContent = 'Subscribe';
        btn.disabled = false;
        msg.textContent = 'Something went wrong. Email us at team@theyardlab.com.';
      }
    }).catch(function() {
      btn.textContent = 'Subscribe';
      btn.disabled = false;
      msg.textContent = 'Something went wrong. Email us at team@theyardlab.com.';
    });
  });
})();
</script>
